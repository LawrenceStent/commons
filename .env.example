# Copy to .env (git-ignored) and fill in. Commons reads it at start-up; variables already set in your shell win.
# Nothing here is ever committed, printed or sent anywhere but the service it belongs to.

# Image generation. Local (your choice, 7 Oct): FLUX.2 [klein] 4B on this Mac through mflux; see docs/IMAGES.md
IMAGES=local                       # local, or leave empty to use BFL's API (below) if a key is set
MFLUX_MODEL=~/models/flux2-klein-4b-q4   # the folder mflux-save wrote (or flux2-klein-4b to load the full weights)

# Or Black Forest Labs' API (FLUX.2), https://bfl.ai
BFL_API_KEY=
BFL_MODEL=flux-2-klein-9b          # or flux-2-pro
BFL_PRICE_PER_IMAGE=0.03           # dollars, for the ledger and the daily cap; set to what your plan charges

# Etsy Open API v3: an app (keystring and shared secret) and an OAuth token for your shop
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=                 # any value once `uv run python -m packs.storefront.etsy_login` has signed you in
ETSY_REFRESH_TOKEN=                # (it writes the real pair to runs/etsy-token.json, which wins)
ETSY_TAXONOMY_ID=                  # the category for digital prints (find it in Etsy's seller taxonomy)
ETSY_ACTIVATE=no                   # no: listings stay drafts (free) for you to check in Etsy; yes: they go live
ETSY_CURRENCY=USD                  # the shop's currency, as Etsy shows it (a UK shop: GBP); checked before listing
ETSY_USD_RATE=                     # needed unless USD: shop currency per dollar (GBP: about 0.75); prices go out at it
ETSY_FEES=                         # us or uk (default: uk for GBP, else us), for the fee estimate per sale

# Lemon Squeezy: an API key (test mode first) and your store
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
